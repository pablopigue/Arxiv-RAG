# This is a example for the env
# Embeddings / reranking
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_USE_RERANKER=true

# Retrieval
RAG_TOP_K=20
RAG_TOP_N=5
RAG_USE_HYBRID=true

# LLM (any init_chat_model provider; Ollama runs locally)
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.1
RAG_OLLAMA_HOST=http://localhost:11434
RAG_TEMPERATURE=0.1

# LangSmith tracing (free account at https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arxiv-rag
